generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("CLOUD_DATABASE_URL")
}

model Owner {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?
  name         String?
  googleId     String?    @unique
  authProvider String     @default("EMAIL")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  isVerified   Boolean    @default(false)
  businesses   Business[]
}

model OtpCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model Business {
  id             String          @id @default(uuid())
  name           String
  currency       String          @default("FCFA")
  secretKey      String          @unique
  type           String?         @default("SERVICE")
  ownerId        String
  isActivated    Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  owner          Owner           @relation(fields: [ownerId], references: [id])
  config         Config?
  users          Employee[]
  expenses       Expense[]
  packages       Package[]
  products       Product[]
  sales          Sale[]
  services       Service[]
  stockMovements StockMovement[]
}

model Config {
  id                String   @id @default(uuid())
  mainPasswordHash  String
  adminPasswordHash String
  businessId        String   @unique
  isSynced          Boolean  @default(false)
  updatedAt         DateTime @updatedAt
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Employee {
  id             String     @id @default(uuid())
  name           String
  role           String     @default("EMPLOYEE")
  dateOfBirth    DateTime?  @default(now())
  isSynced       Boolean    @default(false)
  isDeleted      Boolean    @default(false)
  commissionRate Float      @default(0.1)
  businessId     String
  updatedAt      DateTime   @default(now()) @updatedAt
  createdAt      DateTime   @default(now())
  business       Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  salesMade      Sale[]
  prestations    SaleItem[] @relation("Prestations")

  @@unique([businessId, name])
  @@index([businessId])
}

model Product {
  id            String          @id @default(uuid())
  name          String
  unitCost      Float?          @default(0)
  salePrice     Float
  stock         Int             @default(0)
  minStockAlert Int             @default(5)
  isSynced      Boolean         @default(false)
  isDeleted     Boolean         @default(false)
  businessId    String
  updatedAt     DateTime        @default(now()) @updatedAt
  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales         SaleItem[]
  movements     StockMovement[]

  @@unique([businessId, name])
  @@index([businessId])
}

model StockMovement {
  id         String   @id @default(uuid())
  productId  String
  quantity   Int
  type       String
  businessId String
  isSynced   Boolean  @default(false)
  createdAt  DateTime @default(now())
  Business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Service {
  id           String        @id @default(uuid())
  name         String
  price        Float
  isSynced     Boolean       @default(false)
  isDeleted    Boolean       @default(false)
  businessId   String
  updatedAt    DateTime      @default(now()) @updatedAt
  createdAt    DateTime      @default(now())
  packageItems PackageItem[]
  SaleItems    SaleItem[]
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@index([businessId])
}

model Package {
  id         String        @id @default(uuid())
  name       String
  price      Float
  isSynced   Boolean       @default(false)
  isDeleted  Boolean       @default(false)
  businessId String
  updatedAt  DateTime      @default(now()) @updatedAt
  createdAt  DateTime      @default(now())
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items      PackageItem[]
  saleItem   SaleItem[]

  @@unique([businessId, name])
  @@index([businessId])
}

model PackageItem {
  id        Int     @id @default(autoincrement())
  packageId String
  serviceId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model SaleItem {
  id            String    @id @default(uuid())
  type          String
  quantity      Int       @default(1)
  unitPrice     Float
  purchasePrice Float     @default(0)
  total         Float     @default(0)
  commission    Float     @default(0)
  productId     String?
  serviceId     String?
  packageId     String?
  saleId        String?
  employeeId    String?
  employee      Employee? @relation("Prestations", fields: [employeeId], references: [id])
  package       Package?  @relation(fields: [packageId], references: [id])
  product       Product?  @relation(fields: [productId], references: [id])
  Sale          Sale?     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  service       Service?  @relation(fields: [serviceId], references: [id])
}

model Sale {
  id          String        @id @default(uuid())
  saleDate    DateTime      @default(now())
  totalAmount Float         @default(0)
  isSynced    Boolean       @default(false)
  updatedAt   DateTime      @default(now()) @updatedAt
  businessId  String
  employeeId  String?
  paymentType PaymentType[]
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee    Employee?     @relation(fields: [employeeId], references: [id])
  items       SaleItem[]

  @@index([businessId])
  @@index([saleDate])
}

model PaymentType {
  id        String   @id @default(uuid())
  amount    Float
  method    String
  saleId    String?
  isSynced  Boolean  @default(false)
  createdAt DateTime @default(now())
  Sale      Sale?    @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Expense {
  id         String   @id @default(uuid())
  type       String
  note       String?
  amount     Float    @default(0)
  isSynced   Boolean  @default(false)
  isDeleted  Boolean  @default(false)
  date       DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  createdAt  DateTime @default(now())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}
