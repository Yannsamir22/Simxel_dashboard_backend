// prisma/schema.prisma — Cloud Dashboard Backend
// Mirrors cloud.prisma from the POS project (same Supabase DB, read-only schema here)
// DO NOT run prisma migrate from this project — POS owns migrations.
// Use: npx prisma db push --schema=prisma/schema.prisma  (or db pull to sync)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("CLOUD_DATABASE_URL")
}

model Owner {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  businesses   Business[]
}

model Business {
  id          String   @id @default(uuid())
  name        String
  currency    String   @default("FCFA")
  secretKey   String   @unique
  type        String?  @default("SERVICE")
  ownerId     String
  owner       Owner    @relation(fields: [ownerId], references: [id])
  isActivated Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  config         Config?
  users          Employee[]
  products       Product[]
  services       Service[]
  packages       Package[]
  sales          Sale[]
  expenses       Expense[]
  stockMovements StockMovement[]
}

model Config {
  id                String   @id @default(uuid())
  mainPasswordHash  String
  adminPasswordHash String
  businessId        String   @unique
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  isSynced          Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

model Employee {
  id             String    @id @default(uuid())
  name           String
  role           String    @default("EMPLOYEE")
  dateOfBirth    DateTime? @default(now())
  isSynced       Boolean   @default(false)
  isDeleted      Boolean   @default(false)
  commissionRate Float     @default(0.1)
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  updatedAt      DateTime  @updatedAt @default(now())
  createdAt      DateTime  @default(now())

  salesMade   Sale[]
  prestations SaleItem[] @relation("Prestations")

  @@unique([businessId, name])
  @@index([businessId])
}

model Product {
  id            String    @id @default(uuid())
  name          String
  unitCost      Float?    @default(0)
  salePrice     Float
  stock         Int       @default(0)
  minStockAlert Int       @default(5)
  isSynced      Boolean   @default(false)
  isDeleted     Boolean   @default(false)
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  updatedAt     DateTime  @updatedAt @default(now())

  sales     SaleItem[]
  movements StockMovement[]

  @@unique([businessId, name])
  @@index([businessId])
}

model StockMovement {
  id         String   @id @default(uuid())
  productId  String
  quantity   Int
  type       String
  businessId String
  isSynced   Boolean  @default(false)
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  Business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Service {
  id         String   @id @default(uuid())
  name       String
  price      Float
  isSynced   Boolean  @default(false)
  isDeleted  Boolean  @default(false)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  updatedAt  DateTime @updatedAt @default(now())
  createdAt  DateTime @default(now())

  SaleItems    SaleItem[]
  packageItems PackageItem[]

  @@unique([businessId, name])
  @@index([businessId])
}

model Package {
  id         String   @id @default(uuid())
  name       String
  price      Float
  isSynced   Boolean  @default(false)
  isDeleted  Boolean  @default(false)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  updatedAt  DateTime @updatedAt @default(now())
  createdAt  DateTime @default(now())

  items    PackageItem[]
  saleItem SaleItem[]

  @@unique([businessId, name])
  @@index([businessId])
}

model PackageItem {
  id        Int     @id @default(autoincrement())
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model SaleItem {
  id            String   @id @default(uuid())
  type          String
  quantity      Int      @default(1)
  unitPrice     Float
  purchasePrice Float    @default(0)
  total         Float    @default(0)
  commission    Float    @default(0)

  productId  String?
  product    Product?  @relation(fields: [productId], references: [id])
  serviceId  String?
  service    Service?  @relation(fields: [serviceId], references: [id])
  packageId  String?
  package    Package?  @relation(fields: [packageId], references: [id])
  saleId     String?
  Sale       Sale?     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  employeeId String?
  employee   Employee? @relation("Prestations", fields: [employeeId], references: [id])
}

model Sale {
  id          String   @id @default(uuid())
  saleDate    DateTime @default(now())
  totalAmount Float    @default(0)
  isSynced    Boolean  @default(false)
  updatedAt   DateTime @default(now()) @updatedAt
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id])

  items       SaleItem[]
  paymentType PaymentType[]

  @@index([businessId])
  @@index([saleDate])
}

model PaymentType {
  id        String   @id @default(uuid())
  amount    Float
  method    String
  saleId    String?
  Sale      Sale?    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  isSynced  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Expense {
  id         String   @id @default(uuid())
  type       String
  note       String?
  amount     Float    @default(0)
  isSynced   Boolean  @default(false)
  isDeleted  Boolean  @default(false)
  date       DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  createdAt  DateTime @default(now())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}
